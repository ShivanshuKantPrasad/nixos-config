-	// it doesn't matter that we're querying over multiple indices.
+	// Older versions of this tool used the "latest-*-" wildcard below, which
+	// matches every index version that is still alive upstream. Because
+	// ElasticSearch keeps several generations around at once, that returns
+	// duplicate packages from stale nixpkgs snapshots. We instead ask for the
+	// alias list and use only the newest generation for the requested channel.
 	ElasticSearchIndexPrefix = "latest-*-"
+	ElasticSearchAliasesURL  = `https://nixos-search-7-1733963800.us-east-1.bonsaisearch.net:443/_cat/aliases?format=json&h=alias`
 )
 
+var (
+	indexCache  sync.Map // suffix -> resolved index (or wildcard fallback)
+	aliasClient = &http.Client{Timeout: 10 * time.Second}
+)
+
+// resolveIndex returns the newest "latest-<N>-<suffix>" index alias that
+// exists upstream, falling back to the old wildcard if the alias lookup
+// fails for any reason.
+func resolveIndex(suffix string) string {
+	if cached, ok := indexCache.Load(suffix); ok {
+		return cached.(string)
+	}
+
+	index := ElasticSearchIndexPrefix + url.QueryEscape(suffix)
+	req, err := http.NewRequest(http.MethodGet, ElasticSearchAliasesURL, nil)
+	if err == nil {
+		req.SetBasicAuth(ElasticSearchUsername, ElasticSearchPassword)
+		req.Header.Set("Accept", "application/json")
+		if resp, err := aliasClient.Do(req); err == nil {
+			defer resp.Body.Close()
+			var aliases []struct {
+				Alias string `json:"alias"`
+			}
+			if json.NewDecoder(resp.Body).Decode(&aliases) == nil {
+				re := regexp.MustCompile(`^latest-(\d+)-` + regexp.QuoteMeta(suffix) + `$`)
+				newest := -1
+				for _, a := range aliases {
+					m := re.FindStringSubmatch(a.Alias)
+					if m == nil {
+						continue
+					}
+					if n, err := strconv.Atoi(m[1]); err == nil && n > newest {
+						newest = n
+					}
+				}
+				if newest >= 0 {
+					index = fmt.Sprintf("latest-%d-%s", newest, url.QueryEscape(suffix))
+				}
+			}
+		}
+	}
+
+	indexCache.Store(suffix, index)
+	return index
+}
